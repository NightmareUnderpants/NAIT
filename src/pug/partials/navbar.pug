include mixins.pug

nav.navbar.navbar-expand-md.navbar-dark.bg-dark.navbar--double
  .container
    button.navbar-toggler(
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#mainNav"
      aria-controls="mainNav"
      aria-expanded="false"
      aria-label="Toggle navigation"
    )
      span.navbar-toggler-icon

    #mainNav.collapse.navbar-collapse
      ul.navbar-nav.me-auto.mb-2.mb-md-0
        +navItem("index", "/dist/index.html") Главная страница
        +navItem("tables", "/dist/tables.html") Таблица
        +navItem("games", "/dist/games.html") Список игр

      form.d-flex(role="search" action="#" method="get")
        input.form-control.form-control-sm.me-2(type="search" name="q" placeholder="Поиск..." aria-label="Search")
        button.btn.btn-outline-light.btn-sm(type="submit") Найти
